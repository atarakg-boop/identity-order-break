<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>עטרה | סדר ושבירה</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@400;700&family=Frank+Ruhl+Libre:wght@400;500;700&display=swap">
<style>
/* =====================================================
   מערכת: רקע #F2EFE8 · שחור #111111 · טקסט #161616
   גריד 12 עמודות · רווח 18px · שוליים 4% · Noto Sans Hebrew
   פינות מעוגלות וצללים: רק בשקף ה-AI
===================================================== */
:root{
  --f-personal:"Frank Ruhl Libre","David","Times New Roman",serif;
  --bg:#F2EFE8; --black:#111111; --ink:#161616; --ink-2:#4b4843; --line:rgba(22,22,22,.07);
  --red:#E0442B;
  --t-hero:clamp(90px,10vw,150px);
  --t-sub:clamp(22px,1.9vw,28px);
  --t-small:clamp(14px,1.1vw,16px);
  --t-horizon:clamp(28px,3.3vw,50px);
  --t-marker:clamp(22px,2.2vw,32px);
  --t-h2:clamp(60px,7vw,100px);
  --t-body:clamp(20px,1.8vw,26px);
  --t-ai:clamp(50px,6vw,90px);
  --t-break:clamp(60px,6.4vw,100px);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;background:var(--bg)}
body{background:var(--bg);color:var(--ink);font-family:"Noto Sans Hebrew",Arial,sans-serif;overflow-x:hidden}
button{font-family:inherit}

/* קווי הגריד ברקע: קו יחיד, ריבועים אחידים.
   גודל הריבוע = עמודה אחת + רווח אחד; כל קו אנכי נופל על הקצה הימני של עמודה (RTL). */
.lines{position:fixed;inset:0;z-index:0;pointer-events:none;
  --W:min(92vw,1500px);--cols:12;--m:calc((var(--W) + 18px) / var(--cols));
  background-image:linear-gradient(90deg,var(--line) 1px,transparent 1px),linear-gradient(var(--line) 1px,transparent 1px);
  background-size:var(--m) var(--m);
  background-position:calc((100vw - var(--W)) / 2 - 18px) 0}

.grid{width:min(92vw,1500px);margin:0 auto;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:18px}
section{position:relative;z-index:1}

/* פס עליון */
.bar{position:fixed;top:0;right:0;left:0;z-index:100;padding:18px 1.2vw;display:flex;justify-content:space-between;
  font-size:14px;font-weight:700;letter-spacing:.04em;color:#fff;mix-blend-mode:difference;pointer-events:none}
.bar .count{direction:ltr;unicode-bidi:isolate;font-variant-numeric:tabular-nums}

/* ---------- 01 פתיחה ---------- */
.hero{min-height:100vh;display:flex;align-items:center;padding-block:110px 70px}
.hero-name{grid-column:1 / 5;font-size:var(--t-hero);font-weight:700;line-height:.9;letter-spacing:-.01em;position:relative}
.hero-name svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
.hero-name span{display:block}
.hero-info{grid-column:7 / 12;align-self:start;margin-top:4vh}
.hero-label{font-size:var(--t-small);font-weight:700;letter-spacing:.06em}
.hero-text{font-size:var(--t-sub);line-height:1.55;margin-top:22px}
.words{margin-top:44px;border-top:1px solid var(--ink)}
.words div{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid rgba(22,22,22,.25)}
.words span{font-size:var(--t-sub);padding:18px 0}

/* ---------- 02 הפורטרט ---------- */
.portrait{height:160vh;background:var(--bg)}
.p-sticky{position:sticky;top:0;height:100vh;padding:0 1.6vw}
.p-frame{position:relative;width:100%;height:100%;overflow:hidden;background:#bbb}
.zoom{position:absolute;inset:0;--z:1;transform:scale(var(--z));will-change:transform}
.zoom img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(100%) contrast(1.05);transition:filter .6s ease}
.portrait.active .zoom img{filter:grayscale(80%) contrast(1.05)}
.h-line{position:absolute;right:3%;height:1px;background:rgba(255,255,255,.85);width:0;transition:width 1.2s ease}
.portrait.active .h-line{width:94%}
.h-label{position:absolute;right:3%;font-size:var(--t-small);letter-spacing:.08em;color:#fff;opacity:.9}
.h-title{position:absolute;right:3%;font-family:var(--f-personal);font-size:var(--t-horizon);font-weight:500;line-height:1.05;color:#fff;
  opacity:0;transform:translateY(14px);transition:opacity 1s ease .5s,transform 1s ease .5s;text-shadow:0 1px 18px rgba(0,0,0,.25)}
.portrait.active .h-title{opacity:1;transform:none}
.marker{position:absolute;width:22px;height:22px;border-radius:50%;border:1px solid #2a2a2a;background:#EFEBE3;cursor:pointer;
  scale:calc(1 / var(--z));transition:transform .3s ease,background .3s ease}
.marker:hover,.marker:focus-visible,.marker.on{transform:scale(1.5);background:#fff;outline:none}
.marker.on{background:var(--ink);border-color:#fff}
.m-text{font-family:var(--f-personal);position:absolute;right:3%;bottom:6vh;width:min(520px,88%);padding-top:18px;border-top:1px solid #fff;color:#fff;
  font-size:var(--t-marker);line-height:1.25;opacity:0;transform:translateY(16px);transition:opacity .4s ease,transform .4s ease;
  pointer-events:none;text-shadow:0 1px 14px rgba(0,0,0,.35)}
.m-text.show{opacity:1;transform:none}
.m-text b{display:block;font-size:clamp(40px,4.4vw,68px);font-weight:500;line-height:1;margin-bottom:14px}
.p-hint{position:absolute;left:3%;bottom:6vh;color:#fff;font-size:var(--t-small);opacity:.85}

/* ---------- 03 הגרסה המסודרת ---------- */
.ordered{min-height:100vh;display:flex;align-items:center;padding-block:120px}
.ordered h2{grid-column:1 / 7;font-size:var(--t-h2);font-weight:700;line-height:1.02;letter-spacing:-.01em}
.ordered .sub{grid-column:1 / 7;font-size:var(--t-body);line-height:1.6;margin-top:40px}
.term{grid-column:7 / 13;grid-row:1 / 3;align-self:center;position:relative;border:1px solid #333;background:#F6F4EF;
  font-family:"Courier New",Courier,monospace;font-size:18px;line-height:1.35;padding:24px 24px 64px;min-height:520px;direction:rtl;text-align:right;color:#222}
.term p{white-space:pre-wrap}
.term .bin{position:absolute;right:16px;bottom:14px;font-size:13px;color:#8c8a85}
.term .cur{display:inline-block;width:9px;height:17px;background:#222;vertical-align:-3px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

/* ---------- 04 AI ---------- */
.ai{min-height:100vh;padding:110px 4vw 100px;background:linear-gradient(135deg,#F6EBFF,#E8F6FF);transition:background .8s ease;overflow:hidden}
.ai-label{text-align:center;font-size:13px;letter-spacing:.2em;opacity:.45;margin-bottom:28px;transition:opacity .5s}
.ai-title{text-align:center;font-size:var(--t-ai);font-weight:700;line-height:1.08;max-width:1300px;margin:0 auto;transition:all .8s ease}
.ai-title .no{display:block;color:var(--red);max-height:0;opacity:0;overflow:hidden;transition:max-height .8s ease,opacity .8s ease .3s}
.ai-sub{max-width:720px;margin:24px auto 48px;text-align:center;font-size:20px;line-height:1.6;opacity:.65;transition:all .8s ease}
.cards{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;transition:transform .8s ease}
.card{min-height:240px;padding:35px;border-radius:25px;background:rgba(255,255,255,.8);box-shadow:0 15px 40px rgba(0,0,0,.06);
  direction:rtl;text-align:right;font-family:system-ui,-apple-system,"Segoe UI",Arial,sans-serif;transition:transform .8s ease,border-radius .8s ease,background .8s ease,color .8s ease}
.card small{display:block;font-size:12px;opacity:.45;margin-bottom:56px}
.card h3{font-size:28px;margin-bottom:12px}
.card p{line-height:1.55;opacity:.65}
.ai-btn{display:block;margin:44px auto 0;padding:15px 30px;border:0;border-radius:30px;background:#111;color:#fff;font-size:16px;cursor:pointer;transition:all .4s ease}
.ai-btn:hover{transform:scale(1.05)}
.ai-btn:focus-visible{outline:2px solid var(--red);outline-offset:4px}
/* שבור */
.ai.broken{background:var(--black);color:var(--bg)}
.ai.broken .ai-label{opacity:0}
.ai.broken .ai-title{text-align:right}
.ai.broken .ai-title .no{max-height:2em;opacity:1}
.ai.broken .ai-sub{opacity:.18}
.ai.broken .card{border-radius:0;box-shadow:0 20px 50px rgba(0,0,0,.4);background:#F7F5F1;color:#d8d5cf}
.ai.broken .card:nth-child(1){transform:translateY(60px) rotate(-6deg)}
.ai.broken .card:nth-child(2){transform:translateY(-10px) rotate(3deg)}
.ai.broken .card:nth-child(3){transform:translateY(40px) translateX(-30px) rotate(-9deg)}
.ai.broken .ai-btn{border-radius:0;background:var(--bg);color:#111;transform:rotate(-3deg)}


/* ---------- 05 העמדה ---------- */
.stance{padding-block:140px}
.st-label{grid-column:1 / 4;font-size:var(--t-small);font-weight:700;letter-spacing:.06em;align-self:start;position:sticky;top:90px}
.st-label span{display:block;font-weight:400;color:var(--ink-2);margin-top:6px;letter-spacing:0}
.st-text{grid-column:4 / 11;font-size:clamp(19px,1.5vw,22px);line-height:1.75}
.st-text p{margin-bottom:1.1em}
.st-text p:first-child{font-size:var(--t-sub);line-height:1.5;font-weight:700}

/* ---------- 06 סיום ---------- */
.final{min-height:100vh;background:var(--black);color:var(--bg);display:flex;align-items:center;justify-content:center;overflow:hidden;padding:120px 4vw}
.final canvas{position:absolute;inset:0;width:100%;height:100%}
.final h2{position:relative;text-align:center;font-family:var(--f-personal);font-size:var(--t-break);font-weight:500;line-height:1.08;letter-spacing:-.01em}
.final .note{font-family:var(--f-personal);position:absolute;right:2.5vw;bottom:28px;font-size:var(--t-small);line-height:1.5;opacity:.8}

@media (max-width:800px){
  :root{--t-hero:64px;--t-h2:44px;--t-ai:36px;--t-break:46px}
  .grid{grid-template-columns:repeat(6,minmax(0,1fr))}
  .lines{--cols:6}
  .hero-name,.hero-info,.ordered h2,.ordered .sub,.term,.st-label,.st-text{grid-column:1 / -1}
  .st-label{position:static;margin-bottom:24px}
  .hero-info{margin-top:40px}
  .term{grid-row:auto;min-height:380px;margin-top:40px;font-size:14px}
  .cards{grid-template-columns:minmax(0,1fr)}
  .card{min-height:180px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}html{scroll-behavior:auto}}
</style>

