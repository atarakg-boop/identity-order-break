    g.font=font;g.textBaseline='alphabetic';g.fillText(ch,fs*.3,fs*1.4);
    var d=g.getImageData(0,0,W,H).data,rows=[];
    for(var y=0;y<H;y++){var on=[];for(var x=0;x<W;x++)if(d[(y*W+x)*4+3]>128)on.push(x);if(on.length)rows.push([y,on]);}
    if(!rows.length)return null;
    var r=fromBottom?rows[Math.max(0,rows.length-1-Math.round(fs*.06))]:rows[Math.min(rows.length-1,Math.round(fs*.14))];
    var edge=fromBottom?rows[rows.length-1][0]:rows[0][0];
    return {x1:r[1][0]-fs*.3,x2:r[1][r[1].length-1]-fs*.3+1,y:edge-fs*1.4};
  }
  function linkQL(){
    var h=document.getElementById('hname'),q=document.getElementById('qof'),l=document.getElementById('lamed'),poly=document.querySelector('#link polygon');
    var cs=getComputedStyle(h),fs=parseFloat(cs.fontSize),font=cs.fontWeight+' '+fs+'px '+cs.fontFamily;
    var mc=document.createElement('canvas').getContext('2d');mc.font=font;var asc=mc.measureText('ק').fontBoundingBoxAscent;
    var A=inkCols('ק',font,fs,true),B=inkCols('ל',font,fs,false);if(!A||!B)return;
    l.style.position='relative';l.style.left='0px';
    var hr=h.getBoundingClientRect(),qr=q.getBoundingClientRect(),lr=l.getBoundingClientRect();
    var qb=qr.top+asc-hr.top,lb=lr.top+asc-hr.top,qx=qr.left-hr.left,lx=lr.left-hr.left;
    var qc=qx+(A.x1+A.x2)/2,lc=lx+(B.x1+B.x2)/2,dx=qc-lc;
    l.style.left=dx+'px';
    var w=Math.max(A.x2-A.x1,B.x2-B.x1),ax1=qc-w/2,ax2=qc+w/2,ay=qb+A.y-fs*.08;
    var bx1=ax1,bx2=ax2,by=lb+B.y+fs*.16;
    poly.setAttribute('points',[ax1,ay,ax2,ay,bx2,by,bx1,by].join(' '));
  }
  linkQL();addEventListener('resize',linkQL);
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(linkQL);

  var wc=document.getElementById('stmt').innerText.trim().split(/\s+/).length;document.getElementById('wc').textContent=wc+' מילים';

  /* מונה השקפים */
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)count.textContent=e.target.dataset.n+' — 06';});},{threshold:.4});
  document.querySelectorAll('section[data-n]').forEach(function(s){io.observe(s);});

  /* פורטרט: הפעלה, זום, הצמדה לתמונה */
  var P=document.getElementById('portrait'),img=document.getElementById('pimg'),zoom=document.getElementById('zoom');
  new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)P.classList.add('active');});},{threshold:.25}).observe(P);
  function place(){
    var box=zoom.getBoundingClientRect(),iw=img.naturalWidth||2576,ih=img.naturalHeight||1449;
    var bw=zoom.offsetWidth,bh=zoom.offsetHeight,s=Math.max(bw/iw,bh/ih),w=iw*s,h=ih*s,ox=(bw-w)/2,oy=(bh-h)/2;
    document.querySelectorAll('.marker').forEach(function(m){m.style.left=(ox+w*m.dataset.ix/100-11)+'px';m.style.top=(oy+h*m.dataset.iy/100-11)+'px';});
    var y=oy+h*0.216;
    document.getElementById('hline').style.top=y+'px';
    document.getElementById('hlabel').style.top=(y-30)+'px';
    document.getElementById('htitle').style.top=(y+28)+'px';
    zoom.style.transformOrigin=(ox+w*.32)+'px '+(oy+h*.70)+'px';
  }
  img.addEventListener('load',place);addEventListener('resize',place);place();
  function onScroll(){
    var r=P.getBoundingClientRect(),p=Math.min(1,Math.max(0,-r.top/(r.height-innerHeight)));
    zoom.style.setProperty('--z',(1+p*.15).toFixed(4));
  }
  addEventListener('scroll',onScroll,{passive:true});onScroll();

  /* לחיצה על האבנים */
  var mt=document.getElementById('mtext'),hint=document.getElementById('phint');
  document.querySelectorAll('.marker').forEach(function(m){
    m.addEventListener('click',function(){
      document.querySelectorAll('.marker').forEach(function(o){o.classList.toggle('on',o===m);});
      mt.classList.remove('show');hint.style.opacity=0;
      setTimeout(function(){mt.innerHTML='<b></b>';mt.firstChild.textContent=m.dataset.t;mt.appendChild(document.createTextNode(m.dataset.text));mt.classList.add('show');},150);
    });
  });

  /* שבירת גרסת ה-AI */
  var ai=document.getElementById('ai'),btn=document.getElementById('aiBtn');
  btn.addEventListener('click',function(){var b=ai.classList.toggle('broken');btn.textContent=b?'חזרה לגרסה של המכונה':'ספרו לי עוד';});

  /* סיום: אבנים מרחפות */
  var c=document.getElementById('stones'),x=c.getContext('2d'),st=[],run=false;
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  function size(){var d=Math.min(2,devicePixelRatio||1);c.width=c.offsetWidth*d;c.height=c.offsetHeight*d;x.setTransform(d,0,0,d,0,0);
    st=[];for(var i=0;i<46;i++)st.push({x:Math.random()*c.offsetWidth,y:Math.random()*c.offsetHeight,s:4+Math.random()*20,r:Math.random()*6,vr:(Math.random()-.5)*.004,vy:-.08-Math.random()*.18,a:.25+Math.random()*.55});}
  function draw(){x.clearRect(0,0,c.width,c.height);st.forEach(function(q){
      if(!reduce){q.y+=q.vy;q.r+=q.vr;if(q.y<-30){q.y=c.offsetHeight+30;q.x=Math.random()*c.offsetWidth;}}
      x.save();x.translate(q.x,q.y);x.rotate(q.r);x.fillStyle='rgba(200,198,193,'+q.a+')';x.fillRect(-q.s/2,-q.s/2,q.s,q.s);x.restore();});
    if(run&&!reduce)requestAnimationFrame(draw);}
  size();draw();addEventListener('resize',function(){size();draw();});
  new IntersectionObserver(function(es){es.forEach(function(e){var was=run;run=e.isIntersecting;if(run&&!was)draw();});}).observe(c);
})();
</script>

